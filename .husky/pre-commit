if ! command -v gitleaks >/dev/null 2>&1; then
  echo "❌ gitleaks not found — required for the pre-commit secret scan." >&2
  echo "   Install it with: brew install gitleaks" >&2
  echo "   (other platforms: https://github.com/gitleaks/gitleaks#installing)" >&2
  exit 1
fi

gitleaks protect --staged --redact -v
